{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Susurro",
  "version": "0.1.0",
  "identifier": "dev.susurro.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:mcp && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Susurro",
        "url": "index.html",
        "width": 1040,
        "height": 700,
        "minWidth": 760,
        "minHeight": 520,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "shortDescription": "Dictado por voz y transcripción de reuniones, en local",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.2",
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "externalBin": [
      "binaries/susurro-mcp"
    ]
  }
}
